# 이 파일을 .env.local 로 복사한 뒤 값을 채운다.
# .env* 는 .gitignore 에 있으므로 실제 키는 커밋되지 않는다.
# 값을 찾는 위치는 docs/SUPABASE_SETUP.md 참고.

# Supabase 프로젝트 URL — 예: https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# 공개 키 (sb_publishable_... 로 시작). 브라우저에 노출돼도 되는 키다.
# 옛 이름은 "anon" 키. 둘 다 여기에 넣으면 동작한다.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 비밀 키 (sb_secret_... 로 시작). RLS를 통째로 우회한다.
# 옛 이름은 "service_role" 키.
# ⚠️ 서버에서만 쓴다. NEXT_PUBLIC_ 접두사를 절대 붙이지 말 것.
SUPABASE_SECRET_KEY=
