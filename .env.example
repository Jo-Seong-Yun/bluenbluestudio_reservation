# 이 파일을 .env.local 로 복사한 뒤 값을 채운다.
# .env* 는 .gitignore 에 있으므로 실제 키는 커밋되지 않는다.
# 값을 찾는 위치는 docs/SUPABASE_SETUP.md 참고.

# Supabase 프로젝트 URL — 예: https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# 공개 키 (sb_publishable_... 로 시작). 브라우저에 노출돼도 되는 키다.
# 옛 이름은 "anon" 키. 둘 다 여기에 넣으면 동작한다.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 비밀 키 (sb_secret_... 로 시작). RLS를 통째로 우회한다.
# 옛 이름은 "service_role" 키.
# ⚠️ 서버에서만 쓴다. NEXT_PUBLIC_ 접두사를 절대 붙이지 말 것.
SUPABASE_SECRET_KEY=

# 알림 발송 (Phase 8). 없어도 예약은 그대로 동작하고, 발송만 건너뛴 채
# notification_logs에 실패로 남는다.

# 솔라피(https://solapi.com) API 키/시크릿 — 손님 SMS(접수·확정·취소·
# 리마인드), 사장님 새 예약 SMS 알림에 쓴다.
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
# 솔라피에 사전 등록한 발신번호. 숫자만, 예: 01012345678
SOLAPI_SENDER_PHONE=

# Gmail SMTP — 이메일 알림(사장님 새 예약, 손님 접수/확정/취소/리마인드)에 쓴다.
# 도메인이 없어도 무료로 쓸 수 있어 Resend 대신 Gmail 계정으로 직접 보낸다.
# 1) Google 계정에서 2단계 인증을 켠다.
# 2) https://myaccount.google.com/apppasswords 에서 앱 비밀번호를 발급받는다.
# 3) 아래 GMAIL_USER엔 그 Gmail 주소를, GMAIL_APP_PASSWORD엔 발급받은
#    16자리 값을 공백 없이 넣는다(로그인 비밀번호 아님).
GMAIL_USER=
GMAIL_APP_PASSWORD=

# 카카오 알림톡(솔라피 경유) — 전부 선택 입력이다. 비워두면 손님·사장님
# 모두 SMS로만 안내되고(기존 동작 그대로), 아래 값을 다 채우면 코드
# 변경 없이 해당 목적의 알림이 알림톡으로 바뀐다(안 채운 목적만 SMS 유지).
# 준비물:
# 1) 카카오톡 채널(옛 플러스친구) 개설 — 사업자등록이 있어야 채널명 검수가
#    통과한다.
# 2) 솔라피 콘솔(https://console.solapi.com) → 카카오 알림톡 연동에서 그
#    채널을 발신 프로필로 등록 → 아래 SOLAPI_KAKAO_PF_ID에 발급된 pfId를 넣는다.
# 3) 목적별로 알림톡 템플릿을 등록해 카카오 심사를 받는다. 문구 초안은
#    lib/notifications/templates.ts의 *KakaoVariables 함수들이 쓰는
#    변수(#{상품명}, #{일시}, #{예약번호} 등)를 참고하되, 심사를 통과한
#    실제 문구·변수 이름에 맞춰 그 함수들을 고쳐야 한다.
# 4) 심사 통과 후 발급된 템플릿ID를 목적에 맞게 아래에 채운다.
SOLAPI_KAKAO_PF_ID=
SOLAPI_KAKAO_TEMPLATE_CUSTOMER_REQUESTED=
SOLAPI_KAKAO_TEMPLATE_CUSTOMER_CONFIRMED=
SOLAPI_KAKAO_TEMPLATE_CUSTOMER_CANCELLED=
SOLAPI_KAKAO_TEMPLATE_CUSTOMER_REMINDER=
SOLAPI_KAKAO_TEMPLATE_ADMIN_NEW_REQUEST=

# 촬영 전날 리마인드 Cron(app/api/cron/reminders)을 보호하는 임의의 문자열.
# Vercel이 크론 요청에 자동으로 `Authorization: Bearer <이 값>`을 실어 보낸다.
CRON_SECRET=
